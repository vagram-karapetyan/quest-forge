# ==============================================================================
# Сетевые настройки сервера
# ==============================================================================
# Хост для привязки сервера (127.0.0.1 для локальной разработки, 0.0.0.0 для Docker/облака)
TEXT_QUEST_HOST=127.0.0.1

# Порт HTTP-сервера
TEXT_QUEST_PORT=8000

# Режим автоматической перезагрузки при изменении кода (1 — включено, 0 — выключено)
TEXT_QUEST_RELOAD=0

# ==============================================================================
# База данных
# ==============================================================================
# Относительный или абсолютный путь к файлу базы данных SQLite
TEXT_QUEST_DB=data/text_quest.db

# ==============================================================================
# Безопасность и авторизация (опционально)
# ==============================================================================
# Логин автора/администратора (по умолчанию: admin)
TEXT_QUEST_ADMIN_USER=admin

# Пароль для защиты конструктора и мутирующих эндпоинтов API.
# Если оставить пустым — авторизация ОТКЛЮЧЕНА (режим свободного локального тестирования).
# Для продакшена задайте надежный пароль, например: change-me-strong-secret-password
TEXT_QUEST_ADMIN_PASSWORD=

# Лимит запросов к API с одного IP в минуту (защита от перегрузки)
TEXT_QUEST_RATE_LIMIT_PER_MIN=240
