# Network binding
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# SQLite persistence
DATABASE_PATH=./data/quest-forge.db

# Optional author authentication (leave ADMIN_PASSWORD empty to disable auth locally)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_HOURS=24

# Player session lifetime & seed behavior
GAME_SESSION_TTL_HOURS=168
SEED_DEMOS=true

# Rate limiting & reverse proxy
RATE_LIMIT_MAX=180
RATE_LIMIT_WINDOW_MS=60000
TRUSTED_PROXIES=
